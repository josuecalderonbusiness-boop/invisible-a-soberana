{
  "version": 2,
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api/:path*" },
    { "source": "/bienvenida/:path*", "destination": "/public/bienvenida/index.html" },
    { "source": "/bienvenida", "destination": "/public/bienvenida/index.html" },
    { "source": "/:path*", "destination": "/public/index.html" }
  ]
}
