{
  "version": 2,
  "outputDirectory": "public",
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api/:path*" },
    { "source": "/bienvenida/:path*", "destination": "/bienvenida/index.html" },
    { "source": "/bienvenida", "destination": "/bienvenida/index.html" },
    { "source": "/workbook", "destination": "/workbook/index.html" },
    { "source": "/workbook/:path*", "destination": "/workbook/:path*" },
    { "source": "/soberana7d", "destination": "/soberana7d/index.html" },
    { "source": "/soberana7d/:path*", "destination": "/soberana7d/:path*" },
    { "source": "/quiz", "destination": "/quiz/index.html" },
    { "source": "/quiz/:path*", "destination": "/quiz/:path*" },
    { "source": "/:path*", "destination": "/quiz/index.html" }
  ]
}
